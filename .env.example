# Copy to .env.local and fill in. Never commit real values.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# Project Settings > API. Use the publishable key (sb_publishable_...) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or legacy service_role key. SERVER ONLY.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ---
# razorpay | mock   (mock = local development only, refused on production deployments)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Shipping ---
# shiprocket | manual   (manual = admin enters courier + AWB by hand; valid in production)
SHIPPING_PROVIDER=manual
# Shiprocket API user (Settings > API > Create API user). SERVER ONLY.
SHIPPING_API_KEY=
SHIPPING_API_SECRET=
# Pickup location nickname exactly as configured in Shiprocket, and its pincode
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=
# Token you set in Shiprocket webhook settings (sent as x-api-key header)
SHIPROCKET_WEBHOOK_TOKEN=

# --- Email ---
# resend | console   (console = log emails to the server output, development only)
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="Aarohi Lava Publications <orders@example.com>"
# Where admin notifications (new order, contact form) are sent
ADMIN_NOTIFICATION_EMAIL=

# --- Cron ---
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
